material {
    name : pixelate,
    parameters : [
        {
            type : sampler2d,
            name : colorBuffer,
            precision: high
        },
        {
            type : float,
            name : pixelSize,
            precision: high
        },
        {
            type : float2,
            name : resolution,
            precision: high
        }
    ],
    variables : [
        vertex
    ],
    outputs : [
        {
            name : color,
            target : color,
            type : float4
        }
    ],
    domain : postprocess,
    depthWrite : false,
    depthCulling : false
}

vertex {
    void postProcessVertex(inout PostProcessVertexInputs postProcess) {
        postProcess.vertex.xy = postProcess.normalizedUV;
    }
}

fragment {
    void postProcess(inout PostProcessInputs postProcess) {
        highp vec2 uv = variable_vertex.xy;
        
        // Calculate pixelated UV coordinates
        highp vec2 pixelSize2D = vec2(materialParams.pixelSize) / materialParams.resolution;
        highp vec2 pixelatedUV = floor(uv / pixelSize2D) * pixelSize2D + pixelSize2D * 0.5;
        
        // Sample the texture at the pixelated coordinates
        postProcess.color = texture(materialParams_colorBuffer, pixelatedUV);
    }
}